# ============================================
# MODÈLE DE CONFIGURATION - Copiez ce fichier
# en .env puis remplissez vos valeurs.
# Le fichier .env ne doit JAMAIS être committé.
# ============================================

# --- Discord ---
# Token Discord (obligatoire)
DISCORD_TOKEN=TON_TOKEN_DISCORD_ICI

# ID de l'auteur dont les messages seront supprimés
# (laisser vide pour auto-détection)
DISCORD_AUTHOR_ID=

# --- Serveurs exclus du nettoyage ---
# IDs séparés par des virgules, ex: 123456789,987654321
EXCLUDED_GUILDS=

# --- Planification ---
# Intervalle entre deux cycles de nettoyage (heures)
SCHEDULE_INTERVAL_HOURS=12

# --- Nettoyage ---
# Âge maximum des messages à conserver (jours)
CLEANUP_MAX_AGE_DAYS=30

# Délai entre deux recherches API (ms)
CLEANUP_SEARCH_DELAY=30000

# Délai entre deux suppressions (ms)
CLEANUP_DELETE_DELAY=1200

# --- Webhook Discord (optionnel) ---
# URL complète du webhook pour les notifications
WEBHOOK_URL=

# Niveau minimal de log envoyé au webhook (debug|info|warn|error)
WEBHOOK_MIN_LEVEL=info
